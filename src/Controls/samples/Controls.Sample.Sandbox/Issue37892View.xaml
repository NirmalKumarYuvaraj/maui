<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="Maui.Controls.Sample.Issue37892View"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Maui.Controls.Sample"
    x:Name="ReproRoot"
    AutomationId="Issue37892Repro"
    VerticalOptions="End">
    <Border
        AutomationId="Issue37892Border"
        Background="green"
        Margin="16,8"
        StrokeShape="RoundRectangle 16">
        <Grid
            x:Name="ReproGrid"
            AutomationId="Issue37892Grid"
            Padding="16,12,16,0"
            IsClippedToBounds="True"
            RowDefinitions="Auto,Auto"
            RowSpacing="6">
            <local:Issue37892HeaderLayout Grid.Row="0"/>
            <ScrollView
                x:Name="ReproScrollView"
                AutomationId="Issue37892ScrollView"
                Grid.Row="1"
                HorizontalScrollBarVisibility="Never"
                VerticalScrollBarVisibility="Never">
                <Label
                    x:Name="WrappingLabel"
                    AutomationId="Issue37892WrappingLabel"
                    Margin="0,0,0,12"
                    FontFamily="OpenSansRegular"
                    FontSize="16"
                    Text="This text does need to be two lines at least or else the looping will not begin 12345678901112131415"/>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
