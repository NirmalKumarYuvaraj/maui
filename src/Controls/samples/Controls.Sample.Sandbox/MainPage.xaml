<ContentPage
    x:Class="Maui.Controls.Sample.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Issue 37892">
    <VerticalStackLayout
        Padding="24"
        Spacing="16"
        VerticalOptions="Center">
        <Label
            FontAttributes="Bold"
            FontSize="22"
            Text="Infinite measure loop on iOS" />
        <Label
            Text="Tap Launch repro. The target is intentionally pushed as a NavigationPage nested inside this NavigationPage. Watch the device log for SANDBOX: ISSUE37892 messages." />
        <Button
            AutomationId="LaunchIssue37892"
            Clicked="OnLaunchReproClicked"
            Text="Launch repro" />
    </VerticalStackLayout>
</ContentPage>