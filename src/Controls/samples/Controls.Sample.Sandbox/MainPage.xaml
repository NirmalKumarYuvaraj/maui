<ContentPage x:Class="Maui.Controls.Sample.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Three-state CheckBox">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="1. Parent / child (Select all)" FontAttributes="Bold" FontSize="18" />
            <Label Text="The parent (IsThreeState=True) is checked when all toppings are checked, indeterminate (IsChecked=null) when some are, and unchecked when none are. Tapping the parent checks or clears everything."
                   FontSize="13" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="SelectAllCheckBox"
                          AutomationId="SelectAllCheckBox"
                          IsThreeState="True"
                          CheckedChanged="OnSelectAllCheckedChanged" />
                <Label Text="Select all toppings" VerticalOptions="Center" FontAttributes="Bold" />
            </HorizontalStackLayout>
            <Label x:Name="SelectAllStateLabel" AutomationId="SelectAllStateLabel" FontSize="13" />

            <VerticalStackLayout x:Name="ToppingsLayout" Margin="32,0,0,0" Spacing="4">
                <HorizontalStackLayout Spacing="8">
                    <CheckBox AutomationId="CheeseCheckBox" CheckedChanged="OnToppingCheckedChanged" />
                    <Label Text="Cheese" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox AutomationId="MushroomCheckBox" CheckedChanged="OnToppingCheckedChanged" />
                    <Label Text="Mushroom" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox AutomationId="OliveCheckBox" CheckedChanged="OnToppingCheckedChanged" />
                    <Label Text="Olive" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="8">
                    <CheckBox AutomationId="PepperCheckBox" CheckedChanged="OnToppingCheckedChanged" />
                    <Label Text="Pepper" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="2. IsThreeState gates null" FontAttributes="Bold" FontSize="18" />
            <Label Text="On Android and iOS, tapping toggles Checked / Unchecked; tapping an indeterminate box checks it. Use the buttons to assign a state. IsThreeState=True allows null and the orange IsIndeterminate visual state. With IsThreeState=False, assigning null becomes False; turning the flag off also clears an indeterminate state."
                   FontSize="13" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox x:Name="ThreeStateCheckBox"
                          AutomationId="ThreeStateCheckBox"
                          IsThreeState="True"
                          Color="DodgerBlue"
                          PropertyChanged="OnThreeStatePropertyChanged">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="IsChecked">
                                    <VisualState.Setters>
                                        <Setter Property="Color" Value="Green" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IsIndeterminate">
                                    <VisualState.Setters>
                                        <Setter Property="Color" Value="Orange" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </CheckBox>
                <Label x:Name="ThreeStateLabel"
                       AutomationId="ThreeStateLabel"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label x:Name="RequestedStateLabel"
                   AutomationId="RequestedStateLabel"
                   Text="Use the buttons to assign true, false, or null."
                   FontSize="13" />

            <FlexLayout Wrap="Wrap" JustifyContent="Start">
                <Button Text="Unchecked" Margin="0,0,8,8" Clicked="OnSetUnchecked" AutomationId="SetUncheckedButton" />
                <Button Text="Checked" Margin="0,0,8,8" Clicked="OnSetChecked" AutomationId="SetCheckedButton" />
                <Button Text="Indeterminate" Margin="0,0,8,8" Clicked="OnSetIndeterminate" AutomationId="SetIndeterminateButton" />
                <Button Text="Toggle IsEnabled" Margin="0,0,8,8" Clicked="OnToggleEnabled" AutomationId="ToggleEnabledButton" />
                <Button Text="Toggle IsThreeState" Margin="0,0,8,8" Clicked="OnToggleThreeState" AutomationId="ToggleThreeStateButton" />
            </FlexLayout>

            <BoxView HeightRequest="1" Color="LightGray" />

            <Label Text="3. Static states" FontAttributes="Bold" FontSize="18" />
            <HorizontalStackLayout Spacing="16">
                <VerticalStackLayout>
                    <CheckBox />
                    <Label Text="Unchecked" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <CheckBox IsChecked="True" />
                    <Label Text="Checked" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <CheckBox AutomationId="AllowedNullCheckBox" IsThreeState="True" IsChecked="{x:Null}" />
                    <Label Text="Indeterminate" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <CheckBox AutomationId="DisallowedNullCheckBox" IsThreeState="False" IsChecked="{x:Null}" />
                    <Label Text="Null = unchecked" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <CheckBox IsThreeState="True" IsChecked="{x:Null}" Color="Red" />
                    <Label Text="Red" FontSize="12" />
                </VerticalStackLayout>
                <VerticalStackLayout>
                    <CheckBox IsThreeState="True" IsChecked="{x:Null}" IsEnabled="False" />
                    <Label Text="Disabled" FontSize="12" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
