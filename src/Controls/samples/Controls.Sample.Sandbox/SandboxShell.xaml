<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Maui.Controls.Sample.SandboxShell"
    xmlns:local="clr-namespace:Maui.Controls.Sample"
    x:Name="shell"
    FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False"
    Shell.BackgroundColor="#000000"
    Shell.ForegroundColor="#FFFFFF"
    Shell.TabBarBackgroundColor="#000000"
    Shell.TabBarForegroundColor="#FFFFFF"
    Shell.TabBarTitleColor="#FFFFFF"
    Shell.TabBarUnselectedColor="#A0A0A0">

    <TabBar>
        <ShellContent Title="Home"
                      Route="home"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate local:HomePage}"/>
        <ShellContent Title="Draws"
                      Route="draws"
                      Icon="groceries.png"
                      ContentTemplate="{DataTemplate local:DrawsPage}"/>
        <ShellContent Title="Investments"
                      Route="investments"
                      Icon="shopping_cart.png"
                      ContentTemplate="{DataTemplate local:InvestmentsPage}"/>
        <ShellContent Title="Holders"
                      Route="holders"
                      Icon="dotnet_bot.png"
                      ContentTemplate="{DataTemplate local:HoldersPage}"/>
    </TabBar>
</Shell>