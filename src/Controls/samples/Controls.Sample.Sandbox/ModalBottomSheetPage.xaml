<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:translationYAndroidLayoutIssues="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.ModalBottomSheetPage"
             SafeAreaEdges="None"
             BackgroundColor="Transparent"
             Shell.PresentationMode="ModalNotAnimated">
    <translationYAndroidLayoutIssues:CustomBottomSheet>
        <VerticalStackLayout Padding="16"
                             Spacing="12">
            <Label Text="Bottom Sheet Content"
                   TextColor="White"
                   FontSize="24"
                   HorizontalOptions="Center"/>
            <Button Text="Custom button"/>
        </VerticalStackLayout>
    </translationYAndroidLayoutIssues:CustomBottomSheet>
</ContentPage>